# TacitGraph configuration.
# Copy to .env and fill in the values; .env is git-ignored.

# --- LLM provider (needed for llm/hybrid modes and answer generation) ---------
# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# ...or OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# ...or a local OpenAI-compatible server (Ollama, llama.cpp, vLLM).
# Defaults live in config/models.json; these override it.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1:8b

# --- Pipeline behaviour -------------------------------------------------------
# Processing mode: local (spaCy/Presidio, no API cost), llm (GPT-4o) or hybrid
PIPELINE_MODE=local
# Set to false to process email bodies only
PROCESS_ATTACHMENTS=true
# Sentence-transformers model for local embeddings; overrides config/models.json
LOCAL_EMBEDDING_MODEL=
# Describe your corpus once; injected into every LLM system prompt
# PROMPT_DOMAIN_CONTEXT="You are analysing the email archive of an engineering team..."
# GraphRAG routing: auto, local or global
GRAPHRAG_SEARCH_TYPE=auto
# Global search: embedding (1 LLM call) or map_reduce (1 call per community)
GRAPH_RAG_GLOBAL_SEARCH_MODE=embedding
LOG_LEVEL=INFO

# --- Identity registry (stable person IDs across the corpus) -----------------
IDENTITY_REGISTRY_ENABLED=true
IDENTITY_REGISTRY_PATH=./data/identity_registry.json

# --- Paths (optional overrides) -----------------------------------------------
# TACITGRAPH_HOME=/path/to/repo
# TACITGRAPH_CONFIG_DIR=/path/to/config
