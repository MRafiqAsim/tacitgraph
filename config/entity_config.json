  "relationship_types": {
    "structural": {
      "_comment": "Auto-generated edges from chunk/thread structure. Excluded from path finding.",
      "types": [
        "MENTIONED_IN",
        "PARTICIPATED_IN",
        "HAS_ATTACHMENT",
        "PART_OF_THREAD"
      ]
    },
    "semantic": {
      "_comment": "Extracted from text. Used in path finding.",
      "types": {
        "WORKS_AT": {
          "description": "person employed at organization",
          "direction": "person → organization"
        },
        "WORKS_ON": {
          "description": "person works on project/task/initiative",
          "direction": "person → project"
        },
        "REPORTS_TO": {
          "description": "person reports to another person",
          "direction": "subordinate → manager"
        },
        "RESPONSIBLE_FOR": {
          "description": "person/org manages or oversees something",
          "direction": "manager → thing managed"
        },
        "USES": {
          "description": "entity uses a product/technology/tool",
          "direction": "user → product"
        },
        "USES_PROCESS": {
          "description": "facility/org uses a process or workflow",
          "direction": "facility → process"
        },
        "PART_OF": {
          "description": "entity is part of a larger entity",
          "direction": "child → parent"
        },
        "HAS_FACILITY": {
          "description": "organization/location has a facility or site",
          "direction": "organization → facility"
        },
        "HAS_EQUIPMENT": {
          "description": "facility has equipment or machines",
          "direction": "facility → equipment"
        },
        "AUTHORED": {
          "description": "person created/wrote a document",
          "direction": "person → document"
        },
        "ATTENDED": {
          "description": "person attended an event/meeting",
          "direction": "person → event"
        },
        "LOCATED_IN": {
          "description": "entity is in a location",
          "direction": "entity → location"
        },
        "SENT_TO": {
          "description": "person communicated with another person",
          "direction": "sender → recipient"
        },
        "DISCUSSES": {
          "description": "person/email discusses a topic, product, or process",
          "direction": "person → topic"
        },
        "SUPPLIED_BY": {
          "description": "product is supplied by an organization",
          "direction": "product → supplier"
        },
        "PRODUCED_BY": {
          "description": "product is produced by an organization",
          "direction": "product → producer"
        },
        "REPLACED": {
          "description": "new product/process replaced an old one",
          "direction": "new → old"
        },
        "RELATED_TO": {
          "description": "general relationship (use only when no specific type fits)",
          "direction": "entity → entity"
        }
      }
    },
    "prioritized": {
      "_comment": "Semantic edges that get weight boost in path finding.",
      "types": [
        "SENT_BY",
        "WORKS_ON",
        "DISCUSSES",
        "HAS_ATTACHMENT",
        "CONTAINS"
      ]
    }
  },
  "internal_node_types": [
    "CHUNK",
    "THREAD",
    "EMAIL"
  ],
