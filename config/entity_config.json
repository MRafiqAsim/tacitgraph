  "relationship_direction_flips": {
    "_comment": "When LLM outputs these types, flip source/target to normalize direction.",
    "EMPLOYS": {
      "standard": "WORKS_AT",
      "_comment": "ORG employs PERSON -> PERSON WORKS_AT ORG"
    },
    "HIRES": {
      "standard": "WORKS_AT",
      "_comment": "ORG hires PERSON -> PERSON WORKS_AT ORG"
    },
    "CONTAINS": {
      "standard": "PART_OF",
      "_comment": "ORG contains DEPT -> DEPT PART_OF ORG"
    },
    "HOSTS": {
